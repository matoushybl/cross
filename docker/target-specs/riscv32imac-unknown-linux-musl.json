{
  "arch": "riscv32",
  "code-model": "medium",
  "cpu": "generic-rv32",
  "crt-objects-fallback": "musl",
  "crt-static-respected": true,
  "data-layout": "e-m:e-p:32:32-i64:64-n32-S128",
  "default-uwtable": true,
  "dynamic-linking": true,
  "env": "musl",
  "features": "+m,+a,+c,+zba,+zbb,+zbs,+zicsr,+zifencei",
  "has-rpath": true,
  "has-thread-local": true,
  "linker-flavor": "gnu-cc",
  "llvm-abiname": "ilp32",
  "llvm-target": "riscv32-unknown-linux-musl",
  "max-atomic-width": 32,
  "metadata": {
    "description": "RISC-V Linux (kernel 5.4, musl 1.2.5)",
    "host_tools": false,
    "std": true,
    "tier": 3
  },
  "os": "linux",
  "position-independent-executables": true,
  "post-link-objects-fallback": {
    "dynamic-dylib": [
      "crtendS.o",
      "crtn.o"
    ],
    "dynamic-nopic-exe": [
      "crtend.o",
      "crtn.o"
    ],
    "dynamic-pic-exe": [
      "crtendS.o",
      "crtn.o"
    ],
    "static-dylib": [
      "crtendS.o",
      "crtn.o"
    ],
    "static-nopic-exe": [
      "crtend.o",
      "crtn.o"
    ],
    "static-pic-exe": [
      "crtendS.o",
      "crtn.o"
    ]
  },
  "pre-link-objects-fallback": {
    "dynamic-dylib": [
      "crti.o",
      "crtbeginS.o"
    ],
    "dynamic-nopic-exe": [
      "crt1.o",
      "crti.o",
      "crtbegin.o"
    ],
    "dynamic-pic-exe": [
      "Scrt1.o",
      "crti.o",
      "crtbeginS.o"
    ],
    "static-dylib": [
      "crti.o",
      "crtbeginS.o"
    ],
    "static-nopic-exe": [
      "crt1.o",
      "crti.o",
      "crtbegin.o"
    ],
    "static-pic-exe": [
      "rcrt1.o",
      "crti.o",
      "crtbeginS.o"
    ]
  },
  "relro-level": "full",
  "target-family": [
    "unix"
  ],
  "target-pointer-width": 32
}