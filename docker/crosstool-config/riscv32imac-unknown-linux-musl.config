CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_PREFIX_DIR="/x-tools/${CT_TARGET}"
CT_ARCH_RISCV=y
# CT_DEMULTILIB is not set
CT_ARCH_USE_MMU=y
CT_ARCH_ARCH="rv32imac_zba_zbb_zbs"
CT_ARCH_ABI="ilp32"
CT_ARCH_32=y
# CT_ARCH_64 is not set
CT_KERNEL_LINUX=y
CT_LINUX_V_5_19=y
CT_LINUX_VERSION="5.19.16"
CT_LIBC_MUSL=y
CT_MUSL_V_1_2_5=y
CT_MUSL_VERSION="1.2.5"
CT_GCC_V_14=y
CT_GCC_VERSION="14.4.0"
CT_CC_GCC_ENABLE_DEFAULT_PIE=y
CT_CC_LANG_CXX=y
CT_CC_LANG_FORTRAN=y
CT_CC_GCC_LIBGOMP=y
CT_BUILD_MANUALS=n
CT_REMOVE_DOCS=y
CT_LOG_PROGRESS_BAR=n
CT_LOG_ALL=y
